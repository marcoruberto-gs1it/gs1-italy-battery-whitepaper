  "wasteBatteryPreventionManagementInfo": {
    "endUserRoleInWastePrevention": {
      "it-IT": "Conservare la batteria tra 10 e 25 °C e caricarla al 40–60 % se inutilizzata a lungo, per prolungarne la durata."
    },
    "endUserRoleInSeparateCollection": {
      "it-IT": "Non gettare la batteria nei rifiuti urbani: consegnarla ai punti di raccolta differenziata."
    },
    "separateCollectionPoints": {
      "it-IT": "Elenco dei punti di raccolta: https://www.example.com/raccolta"
    },
    "takeBackCollectionPoints": {
      "it-IT": "I distributori ritirano gratuitamente la batteria, senza obbligo di acquisto."
    },
    "preparationForReuseFacilities": {
      "it-IT": "Centro autorizzato per la preparazione per il riutilizzo: Centro Esempio Riuso, Città Esempio."
    },
    "preparationForRepurposingFacilities": {
      "it-IT": "Centro autorizzato per il cambio di destinazione: Centro Esempio Seconda Vita, Città Esempio."
    },
    "wasteBatteryTreatmentFacilities": {
      "it-IT": "Impianto autorizzato di trattamento e riciclaggio: Riciclo Esempio, Città Esempio."
    },
    "wasteBatterySafetyInstructions": {
      "it-IT": "Le batterie al litio danneggiate possono surriscaldarsi o incendiarsi: isolare i contatti e non aprire l'involucro."
    },
    "batteryLabelSymbolMeaning": {
      "it-IT": "Il simbolo del bidone barrato indica la raccolta differenziata obbligatoria."
    },
    "batterySubstancesImpact": {
      "it-IT": "Uno smaltimento scorretto può disperdere nell'ambiente l'elettrolita e i metalli contenuti, con effetti sul suolo, sull'acqua e sulla salute."
    }
  }
